{
  "name": "racebob",
  "version": "1.0.0",
  "private": true,
  "description": "RaceBob - iOS App mit Capacitor, bearbeitbar in VS Code",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "check": "node --check www/js/app.js && node --check www/js/register-sw.js && node --check www/sw.js",
    "ios:init": "npx cap add ios --packagemanager SPM",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:run": "npx cap run ios",
    "icons": "npx capacitor-assets generate --ios"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/assets": "^4.0.0"
  }
}
